# ---------------------------------------------------------------------------
# Cuenta de Bambu Cloud
# ---------------------------------------------------------------------------
BAMBU_EMAIL=tu@email.com
BAMBU_PASSWORD=tu_password
# global (api.bambulab.com) o china (api.bambulab.cn)
BAMBU_REGION=global

# Opcional: si ya tienes un accessToken valido, saltas el login.
# BAMBU_TOKEN=

# Opcional: si tienes varias impresoras, fija cual seguir.
# Si lo dejas vacio coge la primera de la cuenta.
# PRINTER_SERIAL=

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Contrasena para entrar al dashboard. Si la dejas vacia el dashboard es publico.
#
# Ademas de dar acceso, firma la cookie de sesion persistente: cambiarla cierra
# la sesion en TODOS los dispositivos a la vez. Es el boton de panico si crees
# que alguien te ha copiado la cookie.
DASHBOARD_PASSWORD=cambia_esto
# Secreto de sesion. Opcional: si lo dejas vacio el servidor genera uno la
# primera vez y lo guarda con el resto del estado, asi que las sesiones abiertas
# sobreviven a los reinicios igual. Para fijarlo: openssl rand -hex 32
#
# En hospedajes SIN disco (plan gratis de Render) ponlo si o si: sin el, cada
# redespliegue genera uno nuevo e invalida la sesion de 30 dias.
SESSION_SECRET=

# Codigo del panel de administracion (ajustes de avisos y cierre de sesion).
#
# Con roles, este codigo sirve para HACERSE administrador (el primero con solo el
# codigo; los siguientes, ademas, con una invitacion de otro admin). Las huellas
# de los admins se derivan de el: CAMBIARLO REVOCA A TODOS los administradores.
# Pon uno propio: el de ejemplo esta en el repositorio y no protege nada.
ADMIN_CODE=1510
# Maximo de dispositivos administrador.
ADMIN_MAX=3

# Donde se guardan historial, ajustes, suscripciones push y las sesiones
# abiertas del dashboard. Por defecto va junto a TOKEN_FILE, asi que un solo
# volumen persistente cubre todo.
# STATE_FILE=/data/bambu-state.json

# Minutos de enfriamiento antes de dar la pieza por retirable (en ms).
COOLDOWN_MS=900000

# ---------------------------------------------------------------------------
# Notificaciones push al movil (Web Push / PWA)
#
# Genera el par de claves una sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Si cambias estas claves, todos los dispositivos suscritos dejan de recibir
# avisos y hay que volver a activarlos desde la campana del dashboard.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige el estandar; por defecto usa BAMBU_EMAIL.
# VAPID_SUBJECT=mailto:tu@email.com

# ---------------------------------------------------------------------------
# Notificaciones (todas opcionales, puedes usar varias a la vez)
# ---------------------------------------------------------------------------
# Telegram: habla con @BotFather para el token, y con @userinfobot para tu chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: ajustes del canal -> Integraciones -> Webhooks
DISCORD_WEBHOOK=

# Cualquier otra URL que reciba un POST JSON
GENERIC_WEBHOOK=

# Aviso cada N% de progreso. 0 = desactivado, 25 = avisa al 25/50/75%
NOTIFY_PROGRESS_STEP=0

# ---------------------------------------------------------------------------
# Keep-alive (planes que duermen el servicio, como el free de Render)
# ---------------------------------------------------------------------------
# URL publica del dashboard. En Render se rellena sola con RENDER_EXTERNAL_URL.
# KEEPALIVE_URL=https://status.silab3d.com
# Cada cuanto se auto-pincha mientras imprime.
KEEPALIVE_MS=600000
# Cada cuanto mientras enfria. El ultimo ping cae al acabar el enfriamiento,
# que es cuando hay que enviar el aviso de "ya puedes retirarla".
COOLDOWN_KEEPALIVE_MS=900000

# Franja horaria en la que el servicio se mantiene despierto AUNQUE no haya
# nada imprimiendo. Sirve para detectar el arranque de un trabajo al momento:
# dormido no corre nada, asi que si nadie esta en pie cuando empieza la
# impresion, no hay quien se entere.
#
# 0-24 = vigilia permanente, que son 744 h/mes (24 x 31) de las 750 que regala
# Render. Cabe, pero el margen son 6 h y el cupo es POR CUENTA: si tienes otro
# servicio free comiendo del mismo bote, o redespliegas mucho, baja a "9-23"
# (~434 h). "off" desactiva la franja y solo se sostiene mientras imprime.
#
# OJO: tras un reinicio o un redespliegue el primer ping tiene que venir de
# FUERA, porque un proceso dormido no puede despertarse a si mismo. Ver
# .github/workflows/keepalive.yml y el apartado del README.
WAKE_WINDOW=0-24
WAKE_TZ=Europe/Madrid

# ---------------------------------------------------------------------------
# Codigos de error de Bambu Lab
# ---------------------------------------------------------------------------
# El catalogo oficial va versionado en data/bambu-errors.json. Para actualizarlo:
#   npm run errors
# Idioma de las fichas de soporte que se enlazan en cada aviso.
# BAMBU_SUPPORT_LOCALE=es-es

# ---------------------------------------------------------------------------
# Agente de camara (esto va en el .env de la maquina de TU RED, no del VPS)
# ---------------------------------------------------------------------------
PRINTER_IP=192.168.1.50
PRINTER_ACCESS_CODE=12345678
PRINTER_CAMERA_USER=bblp
DASHBOARD_URL=https://tu-dominio.com
CAMERA_INTERVAL_MS=10000

# Token compartido entre el agente y el servidor. Genera uno con: openssl rand -hex 24
# Ponlo IGUAL en el .env del VPS y en el del agente.
AGENT_TOKEN=
